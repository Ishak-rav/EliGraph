# EliGraph — environment variables template
# Copy to .env and fill in your values. Never commit .env.

# ---------------------------------------------------------------------------
# Transport
# ---------------------------------------------------------------------------
ELIGRAPH_TRANSPORT=http           # stdio | http
ELIGRAPH_HTTP_PORT=3000
ELIGRAPH_HTTP_HOST=127.0.0.1     # keep 127.0.0.1 when behind nginx

# ---------------------------------------------------------------------------
# Logging / Audit
# ---------------------------------------------------------------------------
ELIGRAPH_LOG_LEVEL=info           # trace | debug | info | warn | error
ELIGRAPH_AUDIT_FILE=/var/log/eligraph/audit.log  # omit to log stdout only

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------
ELIGRAPH_ALLOW_APP_ONLY=false     # never set to true in production

# ---------------------------------------------------------------------------
# Auth mode — enable exactly ONE of the following
# ---------------------------------------------------------------------------
USE_CLIENT_TOKEN=false            # token provided per session via set-access-token tool
USE_INTERACTIVE=false             # interactive browser or device code
USE_CERTIFICATE=false             # certificate-based auth

# ---------------------------------------------------------------------------
# Microsoft Entra App Registration
# ---------------------------------------------------------------------------
TENANT_ID=
CLIENT_ID=
CLIENT_SECRET=                    # only for OBO server-side exchange
REDIRECT_URI=https://YOUR_DOMAIN/auth/callback
CERTIFICATE_PATH=                 # path to .pem file (USE_CERTIFICATE=true)
CERTIFICATE_PASSWORD=             # optional passphrase

# ---------------------------------------------------------------------------
# Microsoft Graph
# ---------------------------------------------------------------------------
USE_GRAPH_BETA=true               # use /beta endpoint (false = /v1.0 only)
