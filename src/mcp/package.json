{
  "name": "@ishak-rav/eligraph",
  "version": "0.1.0",
  "description": "EliGraph — MCP server for Microsoft 365 and Azure with delegated auth, HTTP transport, and audit trail. Fork of @merill/lokka.",
  "license": "MIT",
  "author": "Ishak Chennouf <ichennouf@eliadis.fr>",
  "contributors": [
    "Merill Fernando (original Lokka author)"
  ],
  "homepage": "https://github.com/Ishak-rav/EliGraph",
  "bugs": "https://github.com/Ishak-rav/EliGraph/issues",
  "main": "main.js",
  "type": "module",
  "keywords": [
    "mcp",
    "microsoft-365",
    "microsoft-graph",
    "azure",
    "entra-id",
    "model-context-protocol",
    "iga",
    "claude"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ishak-rav/EliGraph.git",
    "directory": "src/mcp"
  },
  "bin": {
    "eligraph": "build/main.js"
  },
  "scripts": {
    "build": "tsc",
    "build:unix": "tsc && chmod 755 build/main.js",
    "demo:token": "node build/demo-token-auth.js",
    "test:token": "node build/test-token-auth.js",
    "test:simple": "node build/simple-token-test.js",
    "test:live": "node build/live-test.js",
    "start": "node build/main.js"
  },
  "files": [
    "build"
  ],
  "dependencies": {
    "@azure/identity": "^4.3.0",
    "@microsoft/microsoft-graph-client": "^3.0.7",
    "@modelcontextprotocol/sdk": "^1.26.0",
    "@types/jsonwebtoken": "^9.0.10",
    "isomorphic-fetch": "^3.0.0",
    "jsonwebtoken": "^9.0.2",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/isomorphic-fetch": "^0.0.39",
    "@types/node": "^20.0.0",
    "typescript": "^5.8.2"
  },
  "overrides": {
    "zod": "^3.25.0"
  }
}
